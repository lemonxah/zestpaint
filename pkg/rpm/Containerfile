# Fedora build environment for the ZestSurface .rpm (used by build-rpm.sh --container).
# The .rpm must be built on the Fedora release it targets: a binary built on
# another distro links against its glibc and won't run on Fedora.
ARG BASE=fedora:latest
FROM ${BASE}

# Install the spec's BuildRequires, so this stays in step with zestsurface.spec
COPY zestsurface.spec /tmp/zestsurface.spec
RUN dnf -y install rpm-build 'dnf-command(builddep)' \
    && dnf -y builddep /tmp/zestsurface.spec \
    && dnf clean all
